{
  "name": "apivalk/apivalk",
  "archive": {
    "exclude": [
      "/.github",
      "/.gitignore",
      "/phpunit.xml",
      "/rector.php",
      "/vendor",
      "/docker",
      ".idea",
      "compose.yml",
      ".claude",
      "CLAUDE.md"
    ]
  },
  "description": "A Lightweight, Framework-Agnostic REST API Ecosystem for PHP. Built for speed, precision, and type-safe development.",
  "keywords": [
    "openapi",
    "rest",
    "api",
    "php",
    "type-safe",
    "psr-7",
    "psr-15"
  ],
  "homepage": "https://apivalk.com",
  "license": "MIT",
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "policy": {
      "advisories": {
        "ignore-id": {
          "CVE-2025-45769": "Fixed in firebase/php-jwt 7.0, which requires PHP 8. On our PHP 7.4 baseline 6.10.0 is the newest available; the advisory covers key size validation and does not apply to the JWKS keys Apivalk consumes."
        }
      }
    }
  },
  "authors": [
    {
      "name": "Dominic Poppe",
      "email": "dominic@dopo.dev"
    }
  ],
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "ext-mbstring": "*",
    "psr/container": "^1.1.1 || ^2.0.1",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "firebase/php-jwt": "^6.10 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.6"
  },
  "scripts": {
    "test": "phpunit",
    "test-unit": "phpunit --testsuite \"Apivalk Unit Tests\"",
    "test-integration": "phpunit --testsuite Integration",
    "phpstan": "phpstan analyse --memory-limit=3G",
    "rector": "rector process --dry-run"
  },
  "autoload": {
    "psr-4": {
      "apivalk\\apivalk\\": ""
    },
    "exclude-from-classmap": [
      "/Tests/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Integration\\RealWorld\\": "Tests/Integration/RealWorld/"
    }
  }
}
